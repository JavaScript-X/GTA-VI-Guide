NODE_ENV=production
WEB_PORT=5173
API_GATEWAY_PORT=8080
ALLOWED_ORIGINS=https://gta-vi-guide.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/gta_guide_prod
JWT_ACCESS_SECRET=replace-with-production-secret-from-secret-manager
JWT_REFRESH_SECRET=replace-with-production-refresh-secret-from-secret-manager
OAUTH_REDIRECT_BASE_URL=https://api.gta-vi-guide.example.com
RABBITMQ_URL=amqps://USER:PASSWORD@HOST:5671
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=gta-vi-guide-prod
CDN_BASE_URL=https://cdn.gta-vi-guide.example.com
SENTRY_DSN=https://example@sentry.io/project
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
